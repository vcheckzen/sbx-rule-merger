{
  "source_version": 3,
  "remove_ipv6": true,
  "merge_ipv4": true,
  "drop_covered_ipv4": true,
  "prefer_shortest_suffix": true,
  "ads_priority_over_cn": true,
  "compile_srs": true,
  "keep_json": true,
  "sing_box_binary": "sing-box",
  "out_dir": "out",
  "tmp_dir": "tmp",
  "http_timeout_sec": 180,
  "download_retries": 3,
  "download_concurrency": 6,
  "cn_ip": [
    {
      "tag": "geoip-cn",
      "type": "remote",
      "format": "binary",
